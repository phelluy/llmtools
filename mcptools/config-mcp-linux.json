{
  "mcpServers": {
    "wikipedia": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-trunc-proxy",
        "--max-bytes",
        "20000",
        "--preview-max-chars",
        "3000",
        "--head-lines",
        "40",
        "--tail-lines",
        "20",
        "--store",
        "file:/tmp/mcp-trunc-proxy/",
        "--",
        "npx",
        "-y",
        "wikipedia-mcp",
        "--language",
        "fr"
      ]
    },
    "search": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-trunc-proxy",
        "--max-bytes",
        "20000",
        "--preview-max-chars",
        "3000",
        "--store",
        "file:/tmp/mcp-trunc-proxy/",
        "--",
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://localhost:8888"
      }
    },
    "python": {
      "command": "uvx",
      "args": [
        "--with",
        "fastmcp",
        "--with",
        "sympy",
        "--with",
        "numpy",
        "--with",
        "scipy",
        "--with",
        "matplotlib",
        "--with",
        "pandas",
        "--with",
        "seaborn",
        "--with",
        "scikit-learn",
        "--with",
        "requests",
        "python",
        "./mcp_python_server.py",
        "--dir",
        "./workdir/scripts"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ]
    },
    "shell": {
      "command": "uvx",
      "args": [
        "mcp-shell-server"
      ],
      "env": {
        "ALLOW_COMMANDS": "ls,cat,grep,rg,find,wc,head,tail,diff,git,python,python3,pip3,make,node,npm,cargo,mkdir,touch,cp,mv,echo,pwd"
      }
    }
  }
}
