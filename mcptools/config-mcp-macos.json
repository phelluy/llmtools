{
  "mcpServers": {
    "wikipedia": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-trunc-proxy",
        "--max-bytes",
        "20000",
        "--preview-max-chars",
        "3000",
        "--head-lines",
        "40",
        "--tail-lines",
        "20",
        "--store",
        "file:/tmp/mcp-trunc-proxy/",
        "--",
        "npx",
        "-y",
        "wikipedia-mcp",
        "--language",
        "fr"
      ]
    },
    "search": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-trunc-proxy",
        "--max-bytes",
        "20000",
        "--preview-max-chars",
        "3000",
        "--store",
        "file:/tmp/mcp-trunc-proxy/",
        "--",
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://localhost:8888"
      }
    },
    "python": {
      "command": "uvx",
      "args": [
        "--with",
        "sympy",
        "--with",
        "numpy",
        "--with",
        "scipy",
        "--with",
        "matplotlib",
        "--with",
        "pandas",
        "--with",
        "mcp<2",
        "mcp-python-interpreter",
        "--dir",
        "/Users/helluy/gitlab/llmtools/mcptools/workdir/scripts",
        "--python-path",
        "/Users/helluy/gitlab/llmtools/mcptools/workdir/.venv/bin/python"
      ]
    }
  }
}
